# Terminal Buddy Configuration
# Copy this file to ~/.config/terminal-buddy/buddy.toml
# Run `cp buddy.toml.example ~/.config/terminal-buddy/buddy.toml`

# ─────────────────────────────────────────────────────────────────────────────
# BEHAVIOR CONFIGURATION
# Controls how Terminal Buddy interacts with you
# ─────────────────────────────────────────────────────────────────────────────

[behavior]
# How Terminal Buddy responds to you
# Options: "active" (proactive suggestions), "passive" (only when asked), "teacher" (educational tone)
copilot_personality = "active"

# Level of detail in explanations
# Options: "beginner" (detailed, educational), "intermediate" (balanced), "expert" (concise, technical)
explain_level = "beginner"

# How session titles are generated
# Options: "suggest" (you approve), "auto" (automatic), "manual" (you always title)
session_titling = "suggest"

# When teachable moments appear
# Options: "inline" (immediately), "on-demand" (when you click Explain), "never"
teachable_moments = "inline"

# ─────────────────────────────────────────────────────────────────────────────
# AI CONFIGURATION
# LLM provider and model settings
# ─────────────────────────────────────────────────────────────────────────────

[ai]
# LLM provider: "openrouter" (recommended), "claude", or "gemini"
# OpenRouter gives access to multiple models through one API key
provider = "openrouter"

# Model override (optional - uses provider default if not set)
# OpenRouter examples: "anthropic/claude-sonnet-4-5", "google/gemini-2.0-flash"
# Claude: "claude-sonnet-4-5"
# Gemini: "gemini-2.0-flash"
# model = "anthropic/claude-sonnet-4-5"

# Privacy mode: if true, commands are not sent to external LLMs
# Requires local LLM setup (not yet implemented)
privacy_mode = false

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE CONFIGURATION
# Where your journal data is stored
# ─────────────────────────────────────────────────────────────────────────────

[storage]
# Directory for all Terminal Buddy data (sessions, commands, notes)
data_dir = "~/.terminal-buddy"

# Maximum storage size in GB before cleanup suggestions appear
max_storage_gb = 10

# ─────────────────────────────────────────────────────────────────────────────
# CLEANUP CONFIGURATION
# Automatic bloat detection and cleanup suggestions
# ─────────────────────────────────────────────────────────────────────────────

[cleanup]
# How often to scan for bloat: "daily", "weekly", "monthly", "never"
auto_scan_interval = "weekly"

# Paths to scan for bloat (node_modules, .cache, build artifacts, etc.)
scan_paths = ["~"]
