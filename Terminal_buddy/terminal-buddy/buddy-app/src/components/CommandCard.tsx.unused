import React from 'react';
import { Card, CardHeader, CardTitle, CardContent, CardFooter } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Play, HelpCircle, CheckCircle, XCircle, Clock } from 'lucide-react';

interface CommandCardProps {
    command: string;
    output?: string;
    status: 'success' | 'error' | 'pending';
    timestamp: string;
    duration?: string;
    onExplain?: () => void;
    onReRun?: () => void;
    explainText?: string;
}

export const CommandCard: React.FC<CommandCardProps> = ({
    command,
    output,
    status,
    timestamp,
    duration,
    onExplain,
    onReRun,
    explainText
}) => {
    const isSuccess = status === 'success';
    const isError = status === 'error';

    return (
        <Card className="w-full bg-[#1E293B] border-[#334155] border-l-4 border-l-[#3B82F6] text-[#F1F5F9] font-sans rounded-md shadow-sm mb-6 max-w-3xl font-['Atkinson_Hyperlegible']">
            <CardHeader className="flex flex-row items-center justify-between pb-2 space-y-0">
                <div className="flex items-center space-x-3 text-[#94A3B8] text-[16px]">
                    <Clock className="w-4 h-4" aria-hidden="true" />
                    <span>{timestamp}</span>
                    {duration && <span>· {duration}</span>}
                </div>
                <Badge
                    variant="outline"
                    className={`px-3 py-1 text-[16px] border ${isSuccess ? 'text-[#22C55E] border-[#22C55E]' :
                            isError ? 'text-[#EF4444] border-[#EF4444]' :
                                'text-[#F59E0B] border-[#F59E0B]'
                        }`}
                >
                    {isSuccess ? (
                        <span className="flex items-center"><CheckCircle className="w-4 h-4 mr-2" aria-hidden="true" /> Success</span>
                    ) : isError ? (
                        <span className="flex items-center"><XCircle className="w-4 h-4 mr-2" aria-hidden="true" /> Failed</span>
                    ) : (
                        <span>Pending</span>
                    )}
                </Badge>
            </CardHeader>

            <CardContent className="space-y-4">
                {/* Command Input */}
                <div className="bg-[#0F172A] p-4 rounded-md border border-[#334155]">
                    <code className="text-[#E2E8F0] font-mono text-[16px] font-bold font-['JetBrains_Mono']">
                        $ {command}
                    </code>
                </div>

                {/* Output */}
                {output && (
                    <div className="bg-[#0F172A] p-4 rounded-md border border-[#334155] opacity-90">
                        <pre className="text-[#E2E8F0] font-mono text-[14px] whitespace-pre-wrap font-['JetBrains_Mono']">
                            {output}
                        </pre>
                    </div>
                )}

                {/* Explain Text */}
                {explainText && (
                    <div className="text-[16px] text-[#F1F5F9] leading-relaxed pt-2">
                        <span className="font-bold text-[#3B82F6]">Buddy suggests: </span>
                        {explainText}
                    </div>
                )}
            </CardContent>

            <CardFooter className="flex space-x-4 pt-2">
                <Button
                    onClick={onExplain}
                    className="bg-[#3B82F6] hover:bg-[#2563EB] text-[#F1F5F9] text-[16px] font-bold px-6 py-2 h-auto focus:ring-2 focus:ring-[#3B82F6] focus:ring-offset-2 focus:ring-offset-[#1E293B] cursor-pointer"
                    aria-label="Explain command"
                >
                    <HelpCircle className="w-5 h-5 mr-2" aria-hidden="true" />
                    Explain
                </Button>
                <Button
                    onClick={onReRun}
                    variant="outline"
                    className="bg-transparent border-[#334155] hover:bg-[#334155] text-[#F1F5F9] text-[16px] font-bold px-6 py-2 h-auto focus:ring-2 focus:ring-[#3B82F6] focus:ring-offset-2 focus:ring-offset-[#1E293B] cursor-pointer"
                    aria-label="Re-run command"
                >
                    <Play className="w-5 h-5 mr-2" aria-hidden="true" />
                    Re-run
                </Button>
            </CardFooter>
        </Card>
    );
};

export default CommandCard;
