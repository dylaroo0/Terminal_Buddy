{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genesis-project/schemas/project-dna.json",
  "title": "Project DNA",
  "description": "Comprehensive project understanding document generated by Phase 1 Discovery",
  "type": "object",
  "required": ["metadata", "domain", "vision", "stakeholders", "requirements", "gaps", "recommendations"],
  
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "project_id": { "type": "string" },
        "project_name": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "version": { "type": "string" },
        "status": { 
          "type": "string",
          "enum": ["draft", "validated", "approved", "in_progress", "completed"]
        },
        "validation_count": { "type": "integer" },
        "creator": { "type": "string" }
      },
      "required": ["project_id", "project_name", "created_at", "status"]
    },
    
    "domain": {
      "type": "object",
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "array", "items": { "type": "string" } },
        "industry": { "type": "string" },
        "subdomain": { "type": "string" },
        "domain_specific_context": { "type": "object" }
      },
      "required": ["primary"]
    },
    
    "vision": {
      "type": "object",
      "properties": {
        "core_vision": { "type": "string" },
        "problem_statement": { "type": "string" },
        "solution_approach": { "type": "string" },
        "unique_value_proposition": { "type": "string" },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": { "type": "string" },
              "measurable": { "type": "boolean" },
              "metric": { "type": "string" },
              "target": { "type": "string" }
            }
          }
        },
        "project_origin": {
          "type": "object",
          "properties": {
            "initiator": { "type": "string" },
            "motivation": { "type": "string" },
            "urgency": { "type": "string" }
          }
        }
      },
      "required": ["core_vision", "success_criteria"]
    },
    
    "stakeholders": {
      "type": "object",
      "properties": {
        "end_users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "segment": { "type": "string" },
              "demographics": { "type": "string" },
              "needs": { "type": "array", "items": { "type": "string" } },
              "pain_points": { "type": "array", "items": { "type": "string" } },
              "technical_level": { "type": "string" }
            }
          }
        },
        "decision_makers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name_role": { "type": "string" },
              "decision_authority": { "type": "string" },
              "priorities": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "funding": {
          "type": "object",
          "properties": {
            "source": { "type": "string" },
            "budget_range": { "type": "string" },
            "constraints": { "type": "array", "items": { "type": "string" } }
          }
        },
        "beneficiaries": { "type": "array", "items": { "type": "string" } },
        "gatekeepers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name_role": { "type": "string" },
              "type": { "type": "string" },
              "requirements": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    
    "requirements": {
      "type": "object",
      "properties": {
        "functional": { "type": "array", "items": { "type": "string" } },
        "non_functional": { "type": "array", "items": { "type": "string" } },
        "technical": {
          "type": "object",
          "additionalProperties": true
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "description": { "type": "string" },
              "impact": { "type": "string" }
            }
          }
        },
        "timeline": {
          "type": "object",
          "properties": {
            "target_completion": { "type": "string" },
            "milestones": { "type": "array", "items": { "type": "object" } },
            "hard_deadlines": { "type": "array", "items": { "type": "object" } },
            "flexibility": { "type": "string" }
          }
        }
      }
    },
    
    "current_state": {
      "type": "object",
      "properties": {
        "exists": { "type": "string" },
        "needs_building": { "type": "string" },
        "completion_percentage": { "type": "number" },
        "existing_resources": { "type": "array", "items": { "type": "string" } },
        "technical_debt": { "type": "array", "items": { "type": "string" } }
      }
    },
    
    "gaps": {
      "type": "object",
      "description": "Gaps discovered during Phase 1 analysis",
      "properties": {
        "identified": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "category": { 
                "type": "string",
                "enum": ["technical", "compliance", "process", "expertise", "resource", "strategic"]
              },
              "description": { "type": "string" },
              "impact": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
              "recommendation": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        },
        "user_acknowledged": { "type": "array", "items": { "type": "string" } },
        "user_deferred": { "type": "array", "items": { "type": "string" } }
      }
    },
    
    "research_findings": {
      "type": "object",
      "properties": {
        "industry_best_practices": { "type": "array", "items": { "type": "object" } },
        "competitive_analysis": { "type": "array", "items": { "type": "object" } },
        "regulatory_landscape": { "type": "array", "items": { "type": "object" } },
        "technology_trends": { "type": "array", "items": { "type": "object" } },
        "specialist_types": { "type": "array", "items": { "type": "string" } }
      }
    },
    
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "likelihood": { "type": "string", "enum": ["high", "medium", "low"] },
          "impact": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    
    "recommendations": {
      "type": "object",
      "properties": {
        "specialist_types_needed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "reason": { "type": "string" },
              "existing_match": { "type": "string" },
              "create_new": { "type": "boolean" }
            }
          }
        },
        "suggested_workflows": { "type": "array", "items": { "type": "string" } },
        "suggested_methodologies": { "type": "array", "items": { "type": "string" } },
        "resource_recommendations": { "type": "array", "items": { "type": "string" } },
        "timeline_recommendations": { "type": "array", "items": { "type": "string" } }
      }
    },
    
    "validation_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "iteration": { "type": "integer" },
          "timestamp": { "type": "string", "format": "date-time" },
          "user_response": { "type": "string" },
          "changes_made": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
